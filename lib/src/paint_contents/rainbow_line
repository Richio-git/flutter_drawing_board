import '../paint_extension/ex_paint.dart';
import 'paint_content.dart';

class LineSegment {
  final Offset point;
  final Color color;

  LineSegment(this.point, this.color);
}



double _currentHue = 0.0;
const double _colorStep = 5.0; 

Color getNextRainbowColor() {
  _currentHue = (_currentHue + _colorStep) % 360.0;
  // Saturation (1.0) and Lightness (0.5) for vibrant colors
  return HSLColor.fromAHSL(1.0, _currentHue, 1.0, 0.5).toColor();
}

