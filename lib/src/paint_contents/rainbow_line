import 'dart:ui';

// Import necessary files from the flutter_drawing_board package
import '../paint_extension/ex_offset.dart';
import '../paint_extension/ex_paint.dart';
import 'paint_content.dart';

// Import your utility file
import 'rainbow_utils.dart'; // <--- Ensure this path is correct

class RainbowLine extends PaintContent {
  // Use the same precision as SmoothLine for consistent feel
  final double brushPrecision;
  
  // Storage for all points, widths, and colors
  late List<ColoredSegment> segments; 

  RainbowLine({
    this.brushPrecision = 0.4,
  });

  RainbowLine.data({
    this.brushPrecision = 0.4,
    required this.segments,
    required Paint paint,
  }) : super.paint(paint);


  // --- FACTORY/JSON METHODS (Required for Redo/Undo/Saving) ---
  factory RainbowLine.fromJson(Map<String, dynamic> data) {
    return RainbowLine.data(
      brushPrecision: data['brushPrecision'] as double,
      segments: (data['segments'] as List<dynamic>)
          .map((dynamic e) => ColoredSegment.fromJson(e as Map<String, dynamic>))
          .toList(),
      paint: jsonToPaint(data['paint'] as Map<String, dynamic>),
    );
  }

  @override
  String get contentType => 'RainbowLine';

  // --- DRAWING LOGIC ---

  @override
  void startDraw(Offset startPoint) {
    segments = <ColoredSegment>[
      ColoredSegment(startPoint, paint.strokeWidth, getNextRainbowColor())
    ];
  }

  @override
  void drawing(Offset nowPoint) {
    final ColoredSegment lastSegment = segments.last;
    final double distance = (nowPoint - lastSegment.point).distance;
    final double s = paint.strokeWidth;

    // SmoothLine's logic to calculate strokeWidth
    double strokeWidth = s * (s * 2 / (s * distance));
    if (strokeWidth > s * 2) {
      strokeWidth = s * 2;
    }
    final double preWidth = lastSegment.strokeWidth;
    if (strokeWidth - preWidth > brushPrecision) {
      strokeWidth = preWidth + brushPrecision;
    } else if (preWidth - strokeWidth > brushPrecision) {
      strokeWidth = preWidth - brushPrecision;
    }

    // **KEY CHANGE:** Get a new color for the new segment
    final Color color = getNextRainbowColor();

    // Record the new segment
    segments.add(ColoredSegment(nowPoint, strokeWidth, color));
  }

  @override
  void draw(Canvas canvas, Size size, bool deeper) {
    if (segments.length < 2) return;

    for (int i = 1; i < segments.length; i++) {
      final ColoredSegment p1 = segments[i - 1];
      final ColoredSegment p2 = segments[i];

      // Create a Paint object for each segment to apply its specific color
      final segmentPaint = paint.copyWith(
        strokeWidth: p2.strokeWidth,
        color: p2.color, // Use the segment's unique color
        blendMode: BlendMode.src,
      );

      canvas.drawPath(
        Path()
          ..moveTo(p1.point.dx, p1.point.dy)
          ..lineTo(p2.point.dx, p2.point.dy),
        segmentPaint,
      );
    }
  }

  @override
  void endDraw(Offset endPoint) {}

  @override
  RainbowLine copy() => RainbowLine(brushPrecision: brushPrecision);

  @override
  Map<String, dynamic> toContentJson() {
    return <String, dynamic>{
      'brushPrecision': brushPrecision,
      'segments': segments.map((ColoredSegment e) => e.toJson()).toList(),
      'paint': paint.toJson(),
    };
  }
}
  // You will also need to implement fromJson and toMap methods
  // to ensure undo/redo and saving functionality works with the new data model.
}
